# Optional server configuration only. Default rules mode makes no network requests.
MATCHMIND_PROVIDER=rules
MATCHMIND_API_PORT=4174

# For an authorized future deployment, choose one endpoint kind.
# Never place real credentials or user resource identifiers in this example.
MATCHMIND_ENDPOINT_KIND=foundry_resource
MATCHMIND_MODEL_ENDPOINT=https://example-resource.services.ai.azure.com
MATCHMIND_MODEL_DEPLOYMENT=example-deployment
MATCHMIND_MODEL_PROFILE=gpt-5-mini
MATCHMIND_AUTH_MODE=api_key
MATCHMIND_API_KEY=
# GPT-5 mini must use minimal for this bounded profile; none is rejected.
MATCHMIND_MODEL_REASONING_EFFORT=minimal
# Existing Terra configurations remain supported explicitly:
# MATCHMIND_MODEL_PROFILE=gpt-5.6-terra
# MATCHMIND_MODEL_REASONING_EFFORT=none
# Only list actual local frontend origins; no wildcard or remote origins.
MATCHMIND_ALLOWED_ORIGINS=http://127.0.0.1:4173
# Foundry project mode uses Entra only (not a resource API key):
# MATCHMIND_ENDPOINT_KIND=foundry_project
# MATCHMIND_MODEL_ENDPOINT=https://example-resource.services.ai.azure.com/api/projects/example-project
# MATCHMIND_AUTH_MODE=bearer
# MATCHMIND_ACCESS_TOKEN=

# Alternative Azure OpenAI resource mode (not Foundry project API-key auth):
# MATCHMIND_ENDPOINT_KIND=azure_openai
# MATCHMIND_MODEL_ENDPOINT=https://example-resource.openai.azure.com
# MATCHMIND_AUTH_MODE=api_key
# MATCHMIND_API_KEY=

MATCHMIND_MODEL_TIMEOUT_MS=8000
MATCHMIND_MODEL_MAX_CONCURRENT=2
MATCHMIND_MODEL_MAX_OUTPUT_TOKENS=700
MATCHMIND_MODEL_MAX_RESPONSE_BYTES=65536
MATCHMIND_MODEL_MAX_INPUT_BYTES=32768
# Business call quotas are removed. Legacy MAX_CALLS_PER_SESSION,
# MAX_TOTAL_CALLS and MAX_BUDGET_SESSIONS values are ignored.
# This does not change Azure trial credit expiry or provider/platform limits.
