{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "summary", "fact_claims", "receipt_ids"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["matchmind-answer/1.0"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_id", "player_id", "cutoff_ms"],
      "properties": {
        "match_id": { "type": "string" },
        "player_id": { "type": "string" },
        "cutoff_ms": { "type": "integer" }
      }
    },
    "summary": {
      "type": "string",
      "enum": [
        "Only recorded actions in the frozen snapshot are described.",
        "This is a descriptive sample, not a judgment of ability.",
        "No current attempts are available for a completion-rate comparison.",
        "The available snapshot cannot establish the broader claim in the question.",
        "Some required observations are unavailable."
      ]
    },
    "fact_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string",
            "enum": ["passes_attempted", "passes_completed", "pass_outcomes_known", "pass_completion", "crosses_attempted", "crosses_completed", "cross_outcomes_known", "cross_completion", "shots", "xg_estimate", "xg_samples", "xg_missing"]
          },
          "value": { "type": ["number", "null"] }
        }
      }
    },
    "receipt_ids": { "type": "array", "items": { "type": "string" } }
  }
}
